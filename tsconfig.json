{
    "compilerOptions": {
        "target": "ES6",
        "module": "nodenext",
        "paths": {
            "@/*": ["./src/*"]
        },
        "rootDir": "src",
        "declaration": true,
        "declarationDir": "dist",
        "strict": true,
        "esModuleInterop": true,
        "moduleResolution": "nodenext"
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
}
